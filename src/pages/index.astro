---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import QuickLinks from '../components/home/QuickLinks.astro';
import NewsCard from '../components/news/NewsCard.astro';
import Icon from '../components/ui/Icon.astro';
import ContentImage from '../components/media/ContentImage.astro';
import { render } from 'astro:content';
import { schoolPhotos } from '../data/photos';
import { getActiveAnnouncements, getPublishedGalleries, getPublishedNews } from '../lib/content';
const news = await getPublishedNews();
const announcements = await getActiveAnnouncements();
const announcementViews = await Promise.all(announcements.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const galleries = await getPublishedGalleries();
const featuredGallery = galleries[0];
---

<BaseLayout title="Великогрибовицький ліцей" description="Офіційний сайт Великогрибовицького ліцею Львівської міської ради">
  <Hero />
  <QuickLinks />
  <section class="news-section" aria-labelledby="latest-news-title">
    <div class="container">
      <div class="section-top"><div><span class="eyebrow">Життя ліцею</span><h2 class="section-title" id="latest-news-title">Події, що залишають слід</h2><p class="section-sub">Ділимося моментами, досягненнями й історіями нашої шкільної спільноти.</p></div><a class="text-link" href="/novyny/">Усі новини <Icon name="arrow-right" /></a></div>
      <div class="news-grid">{news.slice(0, 3).map((item) => <NewsCard item={item} />)}</div>
    </div>
  </section>
  <section class="photo-gallery-section" aria-labelledby="gallery-title">
    <div class="container">
      <div class="section-top"><div><span class="eyebrow">Обличчя нашого ліцею</span><h2 class="section-title" id="gallery-title">Життя у світлинах</h2><p class="section-sub">Події, зустрічі та щоденні моменти з життя нашої ліцейної спільноти.</p></div><a class="text-link" href="/halerei/">Усі фотогалереї <Icon name="arrow-right" /></a></div>
      <div class="school-gallery">
        {schoolPhotos.map((photo) => <div class="gallery-shot"><div class="gallery-fallback"><Icon name="book" /><span>Фото ліцею</span></div><ContentImage class="gallery-photo" src={photo.src} alt={photo.alt} sizes="(max-width: 700px) 50vw, 33vw" /></div>)}
      </div>
      {featuredGallery && <a class="text-link gallery-collection-link" href={`/halerei/${featuredGallery.data.slug}/`}>Відкрити фотогалерею <Icon name="arrow-right" /></a>}
    </div>
  </section>
  <section class="feature-section">
    <div class="container feature-grid">
      <div class="feature-art"><div class="circle"><Icon name="book" /></div><div class="panel"><strong>Розвиваємося разом</strong><small>Знання • Люди • Можливості</small></div></div>
      <div class="feature-copy"><span class="eyebrow">Наше середовище</span><h2 class="section-title">Школа, у якій хочеться бути</h2><p>Для нас важливо, щоб освіта була не лише про підручники, а й про довіру, цікавість, самостійність і щоденні відкриття. Ми цінуємо кожного, хто є частиною нашої ліцейної родини.</p><div class="checks"><span class="check"><Icon name="check" /> Турбота й підтримка</span><span class="check"><Icon name="check" /> Простір для творчості</span><span class="check"><Icon name="check" /> Цікаві проєкти</span><span class="check"><Icon name="check" /> Сильна спільнота</span></div><a class="btn btn-dark" href="/pro-litsei/">Дізнатися більше <Icon name="arrow-up-right" /></a></div>
    </div>
  </section>
  <section class="notice-section" aria-labelledby="announcements-title"><div class="container"><div class="notice-card"><div class="notice-content"><span class="eyebrow">Актуальні оголошення</span><h2 id="announcements-title">Важливе для ліцейної спільноти</h2>{announcementViews.length ? <div class="announcement-list">{announcementViews.map(({ entry, Content }) => <article class:list={['announcement-item', { important: entry.data.important }]}><h3>{entry.data.title}</h3><div class="announcement-body"><Content /></div></article>)}</div> : <p>Актуальних оголошень наразі немає.</p>}</div><a href="/kontakty/" class="btn btn-sun">Наші контакти <Icon name="arrow-up-right" /></a></div></div></section>
</BaseLayout>
