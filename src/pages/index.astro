---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import QuickLinks from '../components/home/QuickLinks.astro';
import NewsCard from '../components/news/NewsCard.astro';
import Icon from '../components/ui/Icon.astro';
import ContentImage from '../components/media/ContentImage.astro';
import { render } from 'astro:content';
import { getActiveAnnouncements, getPublishedGalleries, getPublishedNews } from '../lib/content';
const news = await getPublishedNews();
const homepageNews = [...news]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const announcements = await getActiveAnnouncements();
const announcementViews = await Promise.all(announcements.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const galleries = await getPublishedGalleries();
const featuredGallery = galleries[0];
const homePhotos = galleries.flatMap(({ data }) => data.photos).slice(0, 6);
---

<BaseLayout title="Великогрибовицький ліцей" description="Офіційний сайт Великогрибовицького ліцею Львівської міської ради">
  <Hero />
  <QuickLinks />
  <section class:list={['notice-section', 'home-announcements', { 'notice-section-empty': announcementViews.length === 0 }]} aria-labelledby="announcements-title"><div class="container"><div class:list={['notice-card', { 'notice-card-empty': announcementViews.length === 0 }]}><div class="notice-content"><span class="eyebrow">Актуальні оголошення</span><h2 id="announcements-title">Важливе для ліцейної спільноти</h2>{announcementViews.length ? <div class="announcement-list">{announcementViews.map(({ entry, Content }) => <article class:list={['announcement-item', { important: entry.data.important }]}><h3>{entry.data.title}</h3><div class="announcement-body"><Content /></div></article>)}</div> : <p>Актуальних оголошень наразі немає. Попередні повідомлення збережено в архіві.</p>}</div><a href="/oholoshennia/" class="btn btn-sun">Усі оголошення <Icon name="arrow-up-right" /></a></div></div></section>
  <section class="news-section" aria-labelledby="latest-news-title">
    <div class="container">
      <div class="section-top"><div><span class="eyebrow">Життя ліцею</span><h2 class="section-title" id="latest-news-title">Події, що залишають слід</h2><p class="section-sub">Ділимося моментами, досягненнями й історіями нашої шкільної спільноти.</p></div><a class="text-link" href="/novyny/">Усі новини <Icon name="arrow-right" /></a></div>
      <div class="news-grid">{homepageNews.map((item) => <NewsCard item={item} />)}</div>
    </div>
  </section>
  <section class="photo-gallery-section" aria-labelledby="gallery-title">
    <div class="container">
      <div class="section-top"><div><span class="eyebrow">Обличчя нашого ліцею</span><h2 class="section-title" id="gallery-title">Життя у світлинах</h2><p class="section-sub">Події, зустрічі та щоденні моменти з життя нашої ліцейної спільноти.</p></div><a class="text-link" href="/halerei/">Усі фотогалереї <Icon name="arrow-right" /></a></div>
      <div class:list={['school-gallery', { 'school-gallery-four': homePhotos.length === 4 }]}>
        {homePhotos.map((photo) => <div class="gallery-shot"><div class="gallery-fallback"><Icon name="book" /><span>Фото ліцею</span></div><ContentImage class="gallery-photo" src={photo.src} alt={photo.alt} sizes="(max-width: 700px) 50vw, 33vw" lightbox lightboxGroup="home-photos" caption={photo.caption ?? photo.alt} /></div>)}
      </div>
      {featuredGallery && <a class="text-link gallery-collection-link" href={`/halerei/${featuredGallery.data.slug}/`}>Відкрити фотогалерею <Icon name="arrow-right" /></a>}
    </div>
  </section>
</BaseLayout>
