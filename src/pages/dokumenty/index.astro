---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHeader from '../../components/ui/InnerHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { formatDate, getPublishedDocuments } from '../../lib/content';

const documents = await getPublishedDocuments();
const categories = [...new Set(documents.map((item) => item.data.category))];
---

<BaseLayout title="Документи · Великогрибовицький ліцей" description="Документи Великогрибовицького ліцею.">
  <InnerHeader title="Документи" description="Зрозумілий каталог документів, програм і звітів закладу освіти." />
  <section class="content-section documents-index">
    <div class="container">
      <div class="compact-page-tools document-tools">
        <p>Офіційні документи, освітні програми та звіти закладу освіти</p>
        {documents.length > 0 && (
          <div>
            <label class="sr-only" for="doc-search">Пошук документів</label>
            <input class="search" id="doc-search" type="search" placeholder="Пошук за назвою…" autocomplete="off" />
          </div>
        )}
      </div>

      {documents.length > 0 ? (
        <>
          <div class="tag-row" id="osvitnii-protses" aria-label="Категорії документів">
            <button class="filter-btn active" type="button" data-doc-category="all" aria-pressed="true">Усі</button>
            {categories.map((category) => <button class="filter-btn" type="button" data-doc-category={category} aria-pressed="false">{category}</button>)}
          </div>
          <p class="filter-status" id="doc-filter-status" aria-live="polite">Показано документів: {documents.length}</p>
          <div class="doc-list" id="doc-results">
            {documents.map(({ data }) => {
              const documentUrl = data.pdf ?? data.externalUrl!;
              const isLocalPdf = Boolean(data.pdf);
              return (
              <article class="doc-item" id={data.slug} data-doc-item data-category={data.category} data-title={data.title.toLocaleLowerCase('uk')}>
                <span class="doc-symbol"><Icon name="file" /></span>
                <span class="doc-meta">
                  <strong>{data.title}</strong>
                  <small>{data.category}{data.documentDate ? ` · ${formatDate(data.documentDate)}` : ''}{data.academicYear ? ` · ${data.academicYear} н. р.` : ''}</small>
                  <span class="doc-summary">{data.summary}</span>
                </span>
                <span class="doc-actions">
                  {isLocalPdf ? <><a class="btn btn-outline" href={documentUrl} target="_blank" rel="noopener noreferrer">Переглянути</a><a class="btn btn-dark" href={documentUrl} download>Завантажити</a></> : <a class="btn btn-dark" href={documentUrl} target="_blank" rel="noopener noreferrer">Відкрити документ</a>}
                </span>
              </article>
              );
            })}
          </div>
          <div class="empty" id="doc-empty" hidden>За цим запитом документів не знайдено.</div>
        </>
      ) : (
        <div class="empty-state">
          <Icon name="file" />
          <h3>Опублікованих документів наразі немає</h3>
          <p>Документи відображатимуться тут за категоріями та датою публікації.</p>
        </div>
      )}
    </div>
  </section>
  <script>
    const search = document.querySelector<HTMLInputElement>('#doc-search');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-doc-category]')];
    const items = [...document.querySelectorAll<HTMLElement>('[data-doc-item]')];
    const status = document.querySelector('#doc-filter-status');
    const empty = document.querySelector<HTMLElement>('#doc-empty');
    const requested = new URLSearchParams(window.location.search);
    let category = buttons.some((button) => button.dataset.docCategory === requested.get('category')) ? requested.get('category')! : 'all';
    if (search) search.value = requested.get('q') ?? '';

    const updateUrl = () => {
      const url = new URL(window.location.href);
      category === 'all' ? url.searchParams.delete('category') : url.searchParams.set('category', category);
      const query = (search?.value ?? '').trim();
      query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
    };

    const filterDocuments = (saveToUrl = true) => {
      const query = (search?.value ?? '').trim().toLocaleLowerCase('uk');
      let visible = 0;
      items.forEach((item) => {
        const matchesCategory = category === 'all' || item.dataset.category === category;
        const matchesSearch = !query || item.dataset.title?.includes(query);
        item.hidden = !(matchesCategory && matchesSearch);
        if (!item.hidden) visible++;
      });
      if (status) status.textContent = `Показано документів: ${visible}`;
      if (empty) empty.hidden = visible !== 0;
      if (saveToUrl) updateUrl();
    };

    search?.addEventListener('input', () => filterDocuments());
    buttons.forEach((button) => button.addEventListener('click', () => {
      category = button.dataset.docCategory ?? 'all';
      buttons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      filterDocuments();
    }));
    buttons.forEach((button) => {
      const active = button.dataset.docCategory === category;
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    filterDocuments(false);
  </script>
</BaseLayout>
