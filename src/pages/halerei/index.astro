---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHeader from '../../components/ui/InnerHeader.astro';
import ContentImage from '../../components/media/ContentImage.astro';
import { formatDate, getPublishedGalleries } from '../../lib/content';
const galleries = await getPublishedGalleries();
---
<BaseLayout title="Фотогалереї · Великогрибовицький ліцей" description="Фотогалереї Великогрибовицького ліцею."><InnerHeader title="Фотогалереї" description="Події та шкільне життя у світлинах." /><section class="content-section"><div class="container"><div class="gallery-card-grid">{galleries.map(({ data }) => <article class="gallery-card"><a class="gallery-card-image" href={`/halerei/${data.slug}/`}><div class="gallery-fallback">Зображення недоступне</div><ContentImage src={data.cover.src} alt={data.cover.alt} sizes="(max-width: 700px) 100vw, 50vw" /></a><div class="gallery-card-body"><span class="news-category">{data.date ? `${formatDate(data.date)} · ` : ''}{data.photos.length} фото</span><h2><a href={`/halerei/${data.slug}/`}>{data.title}</a></h2><p>{data.description}</p></div></article>)}</div></div></section></BaseLayout>
