---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHeader from '../../components/ui/InnerHeader.astro';
import NewsCard from '../../components/news/NewsCard.astro';
import { getPublishedNews } from '../../lib/content';
const news = await getPublishedNews();
const categories = [...new Set(news.map(item => item.data.category))];
const years = [...new Set(news.map(item => item.data.publishedAt.getFullYear()))].sort((a, b) => b - a);
---
<BaseLayout title="Новини та події · Великогрибовицький ліцей" description="Новини та події Великогрибовицького ліцею.">
  <InnerHeader title="Новини та події" description="Усе найцікавіше з життя нашої ліцейної родини — в одному місці." />
  <section class="content-section news-index"><div class="container"><div class="compact-page-tools"><p>Події, досягнення та ініціативи ліцею</p><a class="text-link" href="/rss.xml">RSS новин</a></div><div class="filter-panel compact-filter-panel"><div><strong>Категорія</strong><div class="tag-row" aria-label="Категорії новин"><button class="filter-btn active" type="button" data-news-category="all" aria-pressed="true">Усі</button>{categories.map(category => <button class="filter-btn" type="button" data-news-category={category} aria-pressed="false">{category}</button>)}</div></div><div><strong>Архів</strong><div class="tag-row"><button class="filter-btn active" type="button" data-news-year="all" aria-pressed="true">Усі роки</button>{years.map(year => <a class="filter-btn" href={`/novyny/rik/${year}/`}>{year}</a>)}</div></div></div><p class="filter-status" id="news-filter-status" aria-live="polite">Показано публікацій: {news.length}</p><div class="wide-news" id="news-results">{news.map(item => <NewsCard item={item} />)}</div><div class="empty" id="news-empty" hidden>У цій категорії публікацій немає.</div></div></section>
  <script>
    const categoryButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-news-category]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-news-card]')];
    const status = document.querySelector('#news-filter-status');
    const empty = document.querySelector<HTMLElement>('#news-empty');
    const selectCategory = (button: HTMLButtonElement, saveToUrl = true) => {
      const selected = button.dataset.newsCategory;
      let visible = 0;
      cards.forEach((card) => {
        card.hidden = selected !== 'all' && card.dataset.category !== selected;
        if (!card.hidden) visible++;
      });
      categoryButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      if (status) status.textContent = `Показано публікацій: ${visible}`;
      if (empty) empty.hidden = visible !== 0;
      if (saveToUrl) {
        const url = new URL(window.location.href);
        !selected || selected === 'all' ? url.searchParams.delete('category') : url.searchParams.set('category', selected);
        window.history.replaceState({}, '', url);
      }
    };
    categoryButtons.forEach((button) => button.addEventListener('click', () => selectCategory(button)));
    const requestedCategory = new URLSearchParams(window.location.search).get('category');
    const requestedButton = categoryButtons.find((button) => button.dataset.newsCategory === requestedCategory);
    if (requestedButton) selectCategory(requestedButton, false);
  </script>
</BaseLayout>
