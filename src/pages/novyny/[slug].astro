---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentImage from '../../components/media/ContentImage.astro';
import { formatDate, getPublishedNews } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getPublishedNews();
  return entries.map((item) => ({ params: { slug: item.data.slug }, props: { item } }));
}

interface Props { item: CollectionEntry<'news'> }
const { item } = Astro.props;
const { Content } = await render(item);
const visuals: Record<string, string> = { Події: 'music', Навчання: 'learning', Спільнота: 'community', Досягнення: 'achievement' };
---

<BaseLayout title={`${item.data.seoTitle ?? item.data.title} · Великогрибовицький ліцей`} description={item.data.seoDescription ?? item.data.summary}>
  <section class="content-section"><div class="container"><article class="article-layout"><a class="article-back" href="/novyny/">← Усі новини</a><header class="article-header"><span class="eyebrow">{item.data.category} · {formatDate(item.data.publishedAt)}</span><h1>{item.data.title}</h1><p class="section-sub">{item.data.summary}</p></header><div class:list={['article-hero', `visual-${visuals[item.data.category]}`]}><div class="gallery-fallback"><span>Фото з архіву ліцею</span></div><ContentImage class="article-real-photo" src={item.data.cover.src} alt={item.data.cover.alt} loading="eager" fetchpriority="high" sizes="(max-width: 900px) 100vw, 850px" /></div><div class="article-prose"><Content /></div>{item.data.gallery.length > 0 && <section class="article-gallery" aria-labelledby="article-gallery-title"><h2 id="article-gallery-title">Фотогалерея</h2><div class="content-photo-grid">{item.data.gallery.map(photo => <figure><div class="content-photo"><div class="gallery-fallback">Фото тимчасово недоступне</div><ContentImage src={photo.src} alt={photo.alt} sizes="(max-width: 700px) 100vw, 50vw" /></div>{photo.caption && <figcaption>{photo.caption}</figcaption>}</figure>)}</div></section>}<a class="btn btn-outline" href="/novyny/">← Повернутися до новин</a></article></div></section>
</BaseLayout>
