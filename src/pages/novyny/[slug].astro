---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentImage from '../../components/media/ContentImage.astro';
import NewsCard from '../../components/news/NewsCard.astro';
import { formatDate, getPublishedNews } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getPublishedNews();
  return entries.map((item) => ({
    params: { slug: item.data.slug },
    props: {
      item,
      related: entries.filter((candidate) => candidate.data.slug !== item.data.slug && candidate.data.category === item.data.category).slice(0, 2),
    },
  }));
}

interface Props { item: CollectionEntry<'news'>; related: CollectionEntry<'news'>[] }
const { item, related } = Astro.props;
const { Content } = await render(item);
const visuals: Record<string, string> = { Події: 'music', Навчання: 'learning', Спільнота: 'community', Досягнення: 'achievement' };
---

<BaseLayout title={`${item.data.seoTitle ?? item.data.title} · Великогрибовицький ліцей`} description={item.data.seoDescription ?? item.data.summary}>
  <section class="content-section"><div class="container"><article class="article-layout"><nav class="breadcrumbs" aria-label="Навігаційний шлях"><a href="/">Головна</a><span aria-hidden="true">/</span><a href="/novyny/">Новини</a><span aria-hidden="true">/</span><span aria-current="page">{item.data.title}</span></nav><header class="article-header"><span class="eyebrow">{item.data.category} · {formatDate(item.data.publishedAt)}</span><h1>{item.data.title}</h1><p class="section-sub">{item.data.summary}</p></header><div class:list={['article-hero', `visual-${visuals[item.data.category]}`]}><div class="gallery-fallback"><span>{item.data.cover ? 'Зображення недоступне' : 'Ілюстрація категорії'}</span></div>{item.data.cover && <ContentImage class="article-real-photo" src={item.data.cover.src} alt={item.data.cover.alt} loading="eager" fetchpriority="high" sizes="(max-width: 900px) 100vw, 850px" />}</div><div class="article-prose"><Content /></div>{item.data.gallery.length > 0 && <section class="article-gallery" aria-labelledby="article-gallery-title"><h2 id="article-gallery-title">Фотогалерея</h2><div class="content-photo-grid">{item.data.gallery.map(photo => <figure><div class="content-photo"><div class="gallery-fallback">Зображення недоступне</div><ContentImage src={photo.src} alt={photo.alt} sizes="(max-width: 700px) 100vw, 50vw" /></div>{photo.caption && <figcaption>{photo.caption}</figcaption>}</figure>)}</div></section>}<a class="btn btn-outline" href="/novyny/">← Повернутися до всіх новин</a></article>{related.length > 0 && <section class="related-materials" aria-labelledby="related-news-title"><div class="related-heading"><span class="eyebrow">Ще за темою</span><h2 id="related-news-title">Пов’язані матеріали</h2></div><div class="related-news-grid">{related.map((relatedItem) => <NewsCard item={relatedItem} />)}</div></section>}</div></section>
</BaseLayout>
