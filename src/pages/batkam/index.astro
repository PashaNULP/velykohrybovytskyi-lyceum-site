---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHeader from '../../components/ui/InnerHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { officialLinks } from '../../data/site';
---

<BaseLayout title="Батькам · Великогрибовицький ліцей" description="Інформація про зарахування, організацію навчання та зв’язок із Великогрибовицьким ліцеєм.">
  <InnerHeader title="Батькам" description="Основна інформація щодо навчання, організації освітнього процесу та зв’язку з ліцеєм." />

  <section class="content-section parent-compact-section">
    <div class="container parent-compact">
      <div class="parent-info-grid">
        <section class="parent-info-panel parent-admission-panel" id="zarahuvannia" aria-labelledby="admission-title">
          <span class="eyebrow">Вступ до ліцею</span>
          <h2 id="admission-title">Зарахування</h2>
          <p>Перевірені правила прийому оприлюднені на офіційній сторінці закладу. Терміни, перелік документів і процедури варто уточнювати безпосередньо в цьому джерелі.</p>
          <a class="btn btn-dark" href={officialLinks.admissionRules} target="_blank" rel="noopener noreferrer">Відкрити правила прийому <Icon name="external" /></a>
        </section>

        <section class="parent-info-panel" id="orhanizatsiia-navchannia" aria-labelledby="learning-title">
          <span class="eyebrow">Освітній процес</span>
          <h2 id="learning-title">Організація навчання</h2>
          <nav class="parent-learning-links" aria-label="Матеріали про організацію навчання">
            <a href="/uchnyam/rozklad/?view=lessons"><span><strong>Розклад уроків</strong><small>За класами та днями тижня</small></span><Icon name="arrow-right" /></a>
            <a href="/uchnyam/rozklad/?view=bells"><span><strong>Розклад дзвінків</strong><small>Час уроків і перерв</small></span><Icon name="arrow-right" /></a>
            <a href="/dokumenty/#rezhym-roboty-litseiu-2026-2027"><span><strong>Режим роботи ліцею</strong><small>2026–2027 навчальний рік</small></span><Icon name="arrow-right" /></a>
            <a href="/dokumenty/?category=Освітній процес#osvitnii-protses"><span><strong>Освітні програми</strong><small>Опубліковані програми за ступенями навчання</small></span><Icon name="arrow-right" /></a>
          </nav>
        </section>
      </div>

    </div>
  </section>
</BaseLayout>
