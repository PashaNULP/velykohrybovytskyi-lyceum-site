---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHeader from '../../components/ui/InnerHeader.astro';
import Icon from '../../components/ui/Icon.astro';
const cards = [{icon:'book',title:'Навчальні матеріали',text:'Корисні посилання, навчальні платформи та матеріали для самостійної роботи.'},{icon:'calendar',title:'Розклад уроків',text:'Посилання на актуальний розклад додамо після узгодження.'},{icon:'users',title:'Учнівське самоврядування',text:'Ініціативи, проєкти та можливості впливати на життя ліцею.'},{icon:'star',title:'Наші можливості',text:'Олімпіади, конкурси, творчі заходи й цікаві події.'}] as const;
---
<BaseLayout title="Учням · Великогрибовицький ліцей"><InnerHeader title="Учням" description="Корисна інформація, навчальні ресурси та можливості для розвитку." /><section class="content-section"><div class="container"><p class="demo-callout"><strong>Демонстраційний розділ.</strong> Актуальні матеріали буде додано після перевірки адміністрацією ліцею.</p><div class="content-grid">{cards.map(card => <article class="info-card"><span class="card-icon"><Icon name={card.icon} /></span><h2>{card.title}</h2><p>{card.text}</p></article>)}</div></div></section></BaseLayout>
