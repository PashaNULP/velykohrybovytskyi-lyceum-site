---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHeader from '../../components/ui/InnerHeader.astro';
import Icon from '../../components/ui/Icon.astro';

const programs = [
  { label: '1–4 класи', title: 'Освітня програма початкової школи', href: '/dokumenty/#osvitnia-prohrama-1-4-2025-2026' },
  { label: '5–8 класи', title: 'Освітня програма НУШ', href: '/dokumenty/#osvitnia-prohrama-5-8-2025-2026' },
  { label: '9–11 класи', title: 'Освітня програма старшої школи', href: '/dokumenty/#osvitnia-prohrama-9-11-2025-2026' },
] as const;
---

<BaseLayout title="Учням · Великогрибовицький ліцей" description="Розклад, освітні програми, новини та корисна інформація для учнів Великогрибовицького ліцею.">
  <InnerHeader title="Учням" description="Розклад навчання, програми та можливості ліцейного життя." />
  <section class="content-section">
    <div class="container student-hub">
      <article class="schedule-callout">
        <div><span class="eyebrow">2026–2027 навчальний рік</span><h2>Розклад уроків і дзвінків</h2><p>Розклад за класами й днями тижня, а також затверджений час уроків для різних вікових груп.</p></div>
        <div class="schedule-preview" aria-label="Розклад за днями тижня"><span>Навчальні дні</span><strong>Пн–Пт</strong></div>
        <a class="btn btn-dark" href="/uchnyam/rozklad/">Відкрити розклад <Icon name="arrow-right" /></a>
      </article>

      <section class="hub-section" aria-labelledby="programs-title">
        <div class="hub-heading"><div><span class="eyebrow">Навчання</span><h2 id="programs-title">Освітні програми</h2></div><a class="text-link" href="/dokumenty/#osvitnii-protses">Усі матеріали <Icon name="arrow-right" /></a></div>
        <div class="resource-list">
          {programs.map((program) => <a class="resource-row" href={program.href}><span class="resource-label">{program.label}</span><strong>{program.title}</strong><Icon name="arrow-right" /></a>)}
        </div>
      </section>

      <section class="hub-section" aria-labelledby="community-title">
        <div class="hub-heading"><div><span class="eyebrow">Ліцейна спільнота</span><h2 id="community-title">Події та ініціативи</h2></div></div>
        <div class="hub-links">
          <a href="/novyny/?category=Спільнота"><span class="card-icon"><Icon name="users" /></span><span><strong>Учнівське самоврядування</strong><small>Ініціативи, волонтерство та учнівські проєкти</small></span><Icon name="arrow-right" /></a>
          <a href="/novyny/"><span class="card-icon"><Icon name="star" /></span><span><strong>Новини ліцею</strong><small>Навчання, творчість, спорт і досягнення</small></span><Icon name="arrow-right" /></a>
          <a href="/oholoshennia/"><span class="card-icon"><Icon name="calendar" /></span><span><strong>Оголошення</strong><small>Організаційні повідомлення та важливі дати</small></span><Icon name="arrow-right" /></a>
          <a href="/kontakty/"><span class="card-icon"><Icon name="phone" /></span><span><strong>Потрібна допомога?</strong><small>Офіційний телефон та адреса ліцею</small></span><Icon name="arrow-right" /></a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
