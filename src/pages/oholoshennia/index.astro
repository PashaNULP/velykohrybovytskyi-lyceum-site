---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHeader from '../../components/ui/InnerHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { formatDate, getPublishedAnnouncements } from '../../lib/content';

const now = new Date();
const announcements = await getPublishedAnnouncements(now);
const views = await Promise.all(announcements.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const active = views.filter(({ entry }) => !entry.data.expiresAt || entry.data.expiresAt >= now);
const archived = views.filter(({ entry }) => entry.data.expiresAt && entry.data.expiresAt < now);
---

<BaseLayout title="Оголошення · Великогрибовицький ліцей" description="Актуальні оголошення та архів повідомлень Великогрибовицького ліцею.">
  <InnerHeader title="Оголошення" description="Важливі повідомлення для учнів, батьків і ліцейної спільноти." />
  <section class="content-section">
    <div class="container page-flow">
      <section aria-labelledby="active-announcements-title"><span class="eyebrow">Зараз актуально</span><h2 class="section-title subsection-title" id="active-announcements-title">Поточні оголошення</h2>{active.length ? <div class="public-announcement-list">{active.map(({ entry, Content }) => <article class:list={['public-announcement', { important: entry.data.important }]}><div class="public-announcement-meta"><span>{formatDate(entry.data.publishedAt)}</span>{entry.data.important && <strong>Важливо</strong>}</div><h3>{entry.data.title}</h3><div class="article-prose compact-prose"><Content /></div></article>)}</div> : <div class="empty-state"><Icon name="calendar" /><h3>Нових повідомлень немає</h3><p>Після публікації актуальні оголошення з’являться в цьому розділі та на головній сторінці.</p></div>}</section>
      {archived.length > 0 && <section class="announcement-archive" aria-labelledby="announcement-archive-title"><span class="eyebrow">Попередні повідомлення</span><h2 class="section-title subsection-title" id="announcement-archive-title">Архів оголошень</h2><div class="public-announcement-list">{archived.map(({ entry, Content }) => <article class="public-announcement archived"><div class="public-announcement-meta"><span>{formatDate(entry.data.publishedAt)}</span><span>Завершено {formatDate(entry.data.expiresAt!)}</span></div><h3>{entry.data.title}</h3><div class="article-prose compact-prose"><Content /></div></article>)}</div></section>}
    </div>
  </section>
</BaseLayout>
