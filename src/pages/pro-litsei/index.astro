---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHeader from '../../components/ui/InnerHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import ContentImage from '../../components/media/ContentImage.astro';

const documents = [
  { label: 'Статут ліцею', detail: 'Затверджений 9 квітня 2021 року', href: '/dokumenty/#statut-velykohrybovytskoho-litseiu' },
  { label: 'Виписка з ЄДР', detail: 'Реєстраційний документ закладу', href: '/dokumenty/#vypyska-z-yedr-velykohrybovytskyi-litsei' },
] as const;
---

<BaseLayout title="Про ліцей · Великогрибовицький ліцей" description="Підтверджена інформація про Великогрибовицький ліцей Львівської міської ради, керівництво, освітнє середовище та проєкти.">
  <InnerHeader title="Про ліцей" description="Великогрибовицький ліцей Львівської міської ради: заклад, команда, освітні напрями й документи." />
  <section class="content-section about-page">
    <div class="container page-flow">
      <section class="about-intro" aria-labelledby="about-intro-title">
        <figure class="about-building-photo"><ContentImage src="/media/images/lyceum/lyceum-building.jpg" alt="Будівля Великогрибовицького ліцею з Державним Прапором України" loading="eager" fetchpriority="high" sizes="(max-width: 800px) 100vw, 50vw" lightbox lightboxGroup="about-lyceum" caption="Будівля ліцею у Великих Грибовичах" /><figcaption>Будівля ліцею у Великих Грибовичах</figcaption></figure>
        <div class="about-intro-copy"><span class="eyebrow">Заклад освіти громади</span><h2 id="about-intro-title">Великогрибовицький ліцей</h2><p>Заклад загальної середньої освіти Львівської міської ради працює у селі Великі Грибовичі та забезпечує навчання учнів початкової, базової і старшої школи.</p><dl class="about-facts"><div><dt>Адреса</dt><dd>с. Великі Грибовичі, вул. Стуса, 1А</dd></div><div><dt>Засновник</dt><dd>Львівська міська рада</dd></div><div><dt>Навчання</dt><dd>Освітні програми для 1–11 класів</dd></div></dl><a class="text-link" href="/kontakty/">Контакти та розташування <Icon name="arrow-right" /></a></div>
      </section>

      <section class="about-section" aria-labelledby="leadership-title">
        <div class="about-section-heading"><span class="eyebrow">Команда</span><h2 id="leadership-title">Керівництво і педагогічний колектив</h2></div>
        <div class="leadership-layout">
          <div class="leadership-list">
            <article><span class="person-initials" aria-hidden="true">ЛС</span><div><h3>Садовська Любов Василівна</h3><p>Директор</p></div></article>
            <article><span class="person-initials" aria-hidden="true">НУ</span><div><h3>Улицька Надія Романівна</h3><p>Заступник директора з НВР з питань організації навчально-виховного процесу</p></div></article>
            <article><span class="person-initials" aria-hidden="true">ГП</span><div><h3>Процевич Галина Василівна</h3><p>Заступник директора з ВР</p></div></article>
          </div>
          <div class="team-copy"><h3>Педагогічна команда</h3><p>Учителі ліцею забезпечують навчання від початкової до старшої школи, беруть участь у професійних зустрічах, проєктній роботі, профорієнтації, творчих і громадянських ініціативах.</p><p>Повний актуальний кадровий склад варто звіряти з офіційним переліком закладу.</p><a class="text-link" href="https://www.hrybovychi-school.com.ua/інформаційна-відкритість/кадровий-склад" target="_blank" rel="noreferrer">Кадровий склад на офіційному сайті <Icon name="external" /></a></div>
        </div>
      </section>

      <section class="about-section" aria-labelledby="learning-title">
        <div class="about-section-heading"><span class="eyebrow">Освітнє середовище</span><h2 id="learning-title">Навчання, відповідальність і практичний досвід</h2><p>Напрями роботи підтверджені матеріалами ліцею та конкретними учнівськими проєктами.</p></div>
        <div class="about-directions"><article><h3>Освітні програми</h3><p>Навчальні плани охоплюють початкову, базову та старшу школу. Ліцей публікує програми й режим роботи у відкритому каталозі документів.</p><a href="/dokumenty/?category=Освітній процес#osvitnii-protses">Переглянути програми</a></article><article><h3>Безпека й доступність</h3><p>Заклад проводить навчальні евакуації, заняття з безпеки та працює над безбар’єрним середовищем і підтримкою дітей з особливими освітніми потребами.</p><a href="/novyny/koordynatsiina-narada-ta-navchalna-evakuatsiia/">Про навчальну евакуацію</a></article><article><h3>Самоврядування і профорієнтація</h3><p>Учні планують власні ініціативи, а заняття в межах DECIDE та зустрічі з фахівцями допомагають досліджувати майбутні професії.</p><a href="/novyny/uchnivske-samovriaduvannia-plany-2026/">Учнівські ініціативи</a></article></div>
      </section>

      <section class="about-projects" aria-labelledby="projects-title">
        <div class="about-section-heading"><span class="eyebrow">Проєкти і традиції</span><h2 id="projects-title">Те, чим живе ліцей</h2></div>
        <div class="about-initiative-links">
          <a href="/zhyttia-litseiu/zapal/">
            <span class="about-initiative-image"><ContentImage src="/media/images/news/2026-07-14-zapal.jpg" alt="Команда шкільного соціального підприємства ЗАПАЛ" sizes="(max-width: 700px) 96px, 120px" /></span>
            <span><strong>Шкільне соціальне підприємство «ЗАПАЛ»</strong><small>Ініціатива ліцею, що поєднує практичну діяльність учнів і соціальне підприємництво.</small></span>
            <Icon name="arrow-right" />
          </a>
          <a href="/zhyttia-litseiu/">
            <span class="about-initiative-symbol"><Icon name="star" /></span>
            <span><strong>Життя ліцею</strong><small>Події, учнівські ініціативи, досягнення та фотогалереї ліцейної спільноти.</small></span>
            <Icon name="arrow-right" />
          </a>
        </div>
      </section>

      <section class="about-documents" aria-labelledby="documents-title"><div class="about-section-heading"><span class="eyebrow">Інформаційна відкритість</span><h2 id="documents-title">Основні документи</h2></div><div class="about-document-list">{documents.map((document) => <a href={document.href}><span><strong>{document.label}</strong><small>{document.detail}</small></span><Icon name="arrow-right" /></a>)}</div><a class="btn btn-outline" href="/dokumenty/">Увесь каталог документів</a></section>
    </div>
  </section>
</BaseLayout>
