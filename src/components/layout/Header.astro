---
import Icon from '../ui/Icon.astro';
import MobileNav from './MobileNav.astro';
import ThemeToggle from './ThemeToggle.astro';
import WinterToggle from '../seasonal/WinterToggle.astro';
import WinterGarland from '../seasonal/WinterGarland.astro';
import { navigation, site } from '../../data/site';

interface Props { currentPath: string }
const { currentPath } = Astro.props;
const isPathActive = (href: string) => currentPath.startsWith(new URL(href, 'https://site.local').pathname);
const isItemActive = (item: typeof navigation[number]) =>
  ('href' in item && isPathActive(item.href))
  || ('children' in item && item.children.some((child) => isPathActive(child.href)));
---

<div class="top-strip">
  <div class="container">
    <div class="left"><span class="tiny-dot"></span>Великі Грибовичі · Львівська міська рада</div>
    <div class="right"><span>вул. Стуса, 1а</span><a href={site.phoneHref}>{site.phone}</a></div>
  </div>
</div>
<header class="header">
  <WinterGarland />
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Великогрибовицький ліцей — головна">
      <img class="logo" src="/images/lyceum-crest.webp" alt="" width="58" height="58" />
      <span><span class="brand-title">Великогрибовицький<br />ліцей</span><span class="brand-sub">Львівської міської ради</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Головна навігація">
      {navigation.map((item, index) => (
        <div class:list={['desktop-nav-item', { 'has-submenu': 'children' in item, active: isItemActive(item) }]} data-desktop-nav-item>
          {'children' in item ? <>
            <div class="desktop-nav-parent">
              <a class:list={['nav-link', { active: isItemActive(item) }]} aria-current={isItemActive(item) ? 'page' : undefined} href={item.href}>{item.label}</a>
              <button class="nav-submenu-toggle" type="button" aria-expanded="false" aria-haspopup="true" aria-controls={`desktop-submenu-${index}`} aria-label={`Відкрити підменю «${item.label}»`} data-desktop-submenu-toggle><span class="submenu-chevron" aria-hidden="true"></span></button>
            </div>
            <div class="desktop-submenu" id={`desktop-submenu-${index}`} data-desktop-submenu>
              <div class="desktop-submenu-inner">{item.children.map((child) => <a href={child.href}>{child.label}</a>)}</div>
            </div>
          </> : <a class:list={['nav-link', { active: isItemActive(item) }]} aria-current={isItemActive(item) ? 'page' : undefined} href={item.href}>{item.label}</a>}
        </div>
      ))}
    </nav>
    <div class="header-actions">
      <WinterToggle />
      <ThemeToggle />
      <a class="btn btn-dark" href="/kontakty/">Контакти <Icon name="arrow-up-right" small /></a>
      <MobileNav currentPath={currentPath} />
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-desktop-nav-item]').forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('[data-desktop-submenu-toggle]');
    const submenu = item.querySelector<HTMLElement>('[data-desktop-submenu]');
    if (!toggle || !submenu) return;
    let closeTimer: number | undefined;

    const closeOtherMenus = () => {
      for (const other of document.querySelectorAll<HTMLElement>('[data-desktop-nav-item].open')) {
        if (other === item) continue;
        other.classList.remove('open');
        other.querySelector<HTMLButtonElement>('[data-desktop-submenu-toggle]')?.setAttribute('aria-expanded', 'false');
      }
    };
    const setOpen = (open: boolean, focusFirst = false) => {
      window.clearTimeout(closeTimer);
      if (open) closeOtherMenus();
      item.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      if (focusFirst) submenu.querySelector<HTMLAnchorElement>('a')?.focus();
    };
    const scheduleClose = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        if (!item.matches(':hover') && !item.contains(document.activeElement)) setOpen(false);
      }, 180);
    };

    item.addEventListener('mouseenter', () => setOpen(true));
    item.addEventListener('focusin', closeOtherMenus);
    item.addEventListener('mouseleave', scheduleClose);
    item.addEventListener('focusout', () => requestAnimationFrame(() => {
      if (!item.contains(document.activeElement)) setOpen(false);
    }));
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    toggle.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setOpen(true, true);
      }
    });
    submenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        toggle.focus();
      }
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    for (const item of document.querySelectorAll<HTMLElement>('[data-desktop-nav-item].open')) {
      if (!item.contains(target)) {
        item.classList.remove('open');
        item.querySelector<HTMLButtonElement>('[data-desktop-submenu-toggle]')?.setAttribute('aria-expanded', 'false');
      }
    }
  });
</script>
