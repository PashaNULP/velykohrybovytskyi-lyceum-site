---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  width?: number;
  height?: number;
  focusX?: number;
  focusY?: number;
  lightbox?: boolean;
  lightboxGroup?: string;
  caption?: string;
  fullSrc?: string;
}

const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes = '(max-width: 700px) 100vw, 50vw',
  width,
  height,
  focusX,
  focusY,
  lightbox = false,
  lightboxGroup,
  caption,
  fullSrc,
} = Astro.props;

const focusStyle = focusX === undefined && focusY === undefined
  ? undefined
  : `--image-focus-x: ${focusX ?? 50}%; --image-focus-y: ${focusY ?? 50}%;`;
---

<img
  class={className}
  src={src}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  style={focusStyle}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  data-fallback-image
  data-lightbox-trigger={lightbox ? '' : undefined}
  data-lightbox-src={lightbox ? (fullSrc ?? src) : undefined}
  data-lightbox-group={lightbox ? lightboxGroup : undefined}
  data-lightbox-caption={lightbox ? (caption ?? alt) : undefined}
  role={lightbox ? 'button' : undefined}
  tabindex={lightbox ? 0 : undefined}
  aria-label={lightbox ? `Відкрити фотографію: ${alt}` : undefined}
/>
