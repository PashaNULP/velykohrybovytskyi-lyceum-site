---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
}

const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes = '(max-width: 700px) 100vw, 50vw',
} = Astro.props;
---

<img
  class={className}
  src={src}
  sizes={sizes}
  alt={alt}
  width="1280"
  height="853"
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  data-fallback-image
/>
