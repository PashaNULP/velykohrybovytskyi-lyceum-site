---
import Icon from '../ui/Icon.astro';

const links = [
  { icon: 'book', label: 'Розклад уроків', description: 'Класи й дні тижня', href: '/uchnyam/rozklad/#lesson-schedule-title' },
  { icon: 'calendar', label: 'Розклад дзвінків', description: 'Уроки та перерви', href: '/uchnyam/rozklad/#bell-schedule-title' },
  { icon: 'star', label: 'Оголошення', description: 'Важливі повідомлення', href: '/oholoshennia/' },
  { icon: 'file', label: 'Документи', description: 'Програми й звіти', href: '/dokumenty/' },
  { icon: 'users', label: 'Контакти', description: 'Телефон і адреса', href: '/kontakty/' },
] as const;
---

<section class="quick-wrap" aria-labelledby="quick-title">
  <div class="container">
    <div class="quick-head"><h2 id="quick-title">Корисне поруч</h2><span>Усе важливе — у два кліки</span></div>
    <div class="quick-grid">
      {links.map((link) => (
        <a class="quick-card" href={link.href}>
          <span class="quick-icon"><Icon name={link.icon} /></span>
          <span class="quick-bottom"><span><span class="quick-label">{link.label}</span><span class="quick-desc">{link.description}</span></span><Icon name="arrow-up-right" /></span>
        </a>
      ))}
    </div>
  </div>
</section>
